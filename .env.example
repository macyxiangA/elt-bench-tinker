# Local test: admin DSN of a throwaway Postgres (grader + episode creation).
ELT_PG_DSN=
# Path to an ELT-Bench checkout (default: ./ELT-Bench).
ELT_BENCH_DIR=

# Snowflake (account identifier like ORG-ACCOUNT).
ELT_SF_ACCOUNT=
ELT_SF_WAREHOUSE=AIRBYTE_WAREHOUSE
# Admin user with SYSADMIN and USERADMIN (creates episode clones, roles and users; grades).
ELT_SF_ADMIN_USER=ELT_ADMIN
ELT_SF_ADMIN_PASSWORD=
# Airbyte's user from ELT-Bench setup/destination/setup.sql (loads the task templates).
ELT_SF_AIRBYTE_USER=AIRBYTE_USER
ELT_SF_AIRBYTE_PASSWORD=
ELT_SF_AIRBYTE_ROLE=AIRBYTE_ROLE

# Airbyte (abctl local credentials; ids from scripts/setup_airbyte.py).
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=
AIRBYTE_API_DEFINITION_ID=

# Tinker (train.py).
TINKER_API_KEY=
